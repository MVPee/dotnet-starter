{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Database": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "ForwardedHeaders": {
    "TrustedNetworks": [
      "10.0.1.0/24"
    ]
  },
  "RateLimiting": {
    "Read": {
      "PermitLimit": 100,
      "Window": "00:01:00",
      "SegmentsPerWindow": 6
    },
    "Write": {
      "PermitLimit": 10,
      "Window": "00:01:00",
      "SegmentsPerWindow": 6
    }
  }
}
